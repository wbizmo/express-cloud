APP_NAME="Express Cloud"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.examplecompany.com
ASSET_URL=
APP_VERSION=1.0.0-dev
FORCE_HTTPS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG
APP_TIMEZONE=Africa/Lagos

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=express_cloud
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=express_cloud

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@express.zivora.com"
MAIL_FROM_NAME="${APP_NAME}"

EXPRESS_CLOUD_CURRENCY=NGN
EXPRESS_CLOUD_CURRENCY_SYMBOL=₦
EXPRESS_CLOUD_MONEY_SCALE=100

CRON_ENABLED=false
CRON_PATH_SECRET=

BACKUP_ENABLED=false
BACKUP_EMAIL=
BACKUP_ENCRYPTION_KEY=

DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
DATA_ENCRYPTION_VERSION=1

VITE_APP_NAME="${APP_NAME}"

# BEGIN EXPRESS CLOUD PHASE 2 TRANSACTION KERNEL
TRANSACTION_RETRY_ATTEMPTS=5
TRANSACTION_RETRY_BASE_DELAY_MS=20
OPERATION_LEASE_SECONDS=120
# END EXPRESS CLOUD PHASE 2 TRANSACTION KERNEL

# BEGIN EXPRESS CLOUD PHASES 6-9
SALES_ROUNDING_MODE=nearest
SALES_ROUNDING_INCREMENT_KOBO=1
SALES_DISCOUNT_APPROVAL_BPS=1500
SALES_PRICE_OVERRIDE_APPROVAL_BPS=1000
SALES_DEFAULT_PAYMENT_TERMS_DAYS=0
POS_RECEIPT_FORMAT=80mm
POS_REPRINT_APPROVAL_AFTER=1
POS_VARIANCE_APPROVAL_THRESHOLD_KOBO=1000
POS_HELD_SALE_EXPIRY_HOURS=24
HR_PAYROLL_ENABLED=false
HR_MAKER_CHECKER_ENABLED=true
HR_ATTENDANCE_GRACE_MINUTES=10
REFERENCE_CACHE_SECONDS=300
DASHBOARD_CACHE_SECONDS=60
EXPORT_STREAM_CHUNK_SIZE=500
HIGH_VOLUME_QUERY_BUDGET=20
# END EXPRESS CLOUD PHASES 6-9
# BEGIN EXPRESS CLOUD PHASES 10-13
PWA_ENABLED=true
PWA_CACHE_VERSION=phase-10-v1
PWA_OPERATION_POLL_SECONDS=3
PWA_OPERATION_POLL_ATTEMPTS=20
PWA_DRAFT_MAX_AGE_HOURS=72
LISA_SNAPSHOT_TTL_SECONDS=300
LISA_SNAPSHOT_STALE_SECONDS=60
LISA_METRIC_VERSION=v1
LISA_CONVERSATION_PAGE_SIZE=20
LISA_MESSAGE_PAGE_SIZE=50
LISA_MAX_QUESTION_CHARACTERS=5000
OPERATIONS_ALERT_EMAIL_1=
OPERATIONS_ALERT_EMAIL_2=
OPERATIONS_ALERT_EMAIL_3=
OPERATIONS_REPORT_TIME=23:00
OPERATIONS_REPORT_TIMEZONE=Africa/Lagos
OPERATIONS_CRON_HMAC_KEY=
OPERATIONS_CRON_CLOCK_SKEW_SECONDS=300
OPERATIONS_DELIVERY_ATTEMPTS=3
RELEASE_ARTIFACT_DIRECTORY=release
RELEASE_REQUIRE_CLEAN_TREE=true
RELEASE_MAX_PHPSTAN_FINDINGS=118
# END EXPRESS CLOUD PHASES 10-13
