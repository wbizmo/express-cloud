<?php

declare(strict_types=1);

namespace App\Http\Controllers\Admin;

use App\Enums\Authentication\SecurityEventType;
use App\Models\Account;
use App\Models\AccountSession;
use App\Services\Authentication\SecurityEventRecorder;
use App\Services\Organisation\AuditLogger;
use Illuminate\Contracts\View\View;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;

final readonly class SessionController
{
    public function __construct(
        private AuditLogger $audit,
        private SecurityEventRecorder $securityEvents,
    ) {}

    public function index(): View
    {
        return view('admin.security.sessions', [
            'sessions' => AccountSession::query()
                ->with('account')
                ->whereNull('revoked_at')
                ->orderByDesc('last_activity_at')
                ->cursorPaginate(config('pagination.default', 10)),
        ]);
    }

    public function revoke(
        Request $request,
        AccountSession $session,
    ): RedirectResponse {
        $session->forceFill(['revoked_at' => now()])->save();

        $this->audit->record(
            $request,
            'session.revoked',
            'account_session',
            $session,
            context: [
                'subject_account_id' => (string) $session->account_id,
            ],
        );

        /** @var Account|null $actor */
        $actor = $request->user();

        $this->securityEvents->record(
            SecurityEventType::SessionRevoked,
            $request,
            actor: $actor,
        );

        return back()->with('status', 'Session revoked.');
    }
}
