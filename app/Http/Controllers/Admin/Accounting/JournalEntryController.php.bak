<?php

declare(strict_types=1);

namespace App\Http\Controllers\Admin\Accounting;

use App\Http\Requests\Admin\Accounting\StoreJournalEntryRequest;
use App\Http\Requests\Admin\Accounting\UpdateJournalEntryRequest;
use App\Models\AccountingPeriod;
use App\Models\JournalEntry;
use App\Models\JournalLine;
use App\Models\LedgerAccount;
use App\Services\Organisation\AuditLogger;
use Illuminate\Contracts\View\View;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;

final readonly class JournalEntryController
{
    public function __construct(private AuditLogger $audit) {}

    public function index(Request $request): View
    {
        $query = JournalEntry::query()
            ->with(['accountingPeriod', 'createdByAccount', 'lines.ledgerAccount'])
            ->orderByDesc('entry_date')
            ->orderByDesc('created_at');

        if ($request->filled('status')) {
            $query->where('status', $request->input('status'));
        }
        if ($request->filled('from')) {
            $query->whereDate('entry_date', '>=', $request->input('from'));
        }
        if ($request->filled('to')) {
            $query->whereDate('entry_date', '<=', $request->input('to'));
        }

        return view('admin.accounting.journal-entries.index', [
            'entries' => $query->paginate(config('pagination.default', 10)),
            'statuses' => ['draft', 'posted', 'reversed'],
        ]);
    }

    public function create(): View
    {
        $periods = AccountingPeriod::query()
            ->where('status', 'open')
            ->orderByDesc('starts_on')
            ->get(['id', 'name']);

        $accounts = LedgerAccount::query()
            ->where('is_active', true)
            ->where('allow_manual_posting', true)
            ->orderBy('code')
            ->get(['id', 'code', 'name', 'type']);

        return view('admin.accounting.journal-entries.create', [
            'periods' => $periods,
            'accounts' => $accounts,
        ]);
    }

    public function store(StoreJournalEntryRequest $request): RedirectResponse
    {
        $validated = $request->validated();

        $entry = DB::transaction(function () use ($validated, $request) {
            $entry = JournalEntry::query()->create([
                'journal_number' => $this->generateJournalNumber(),
                'entry_date' => $validated['entry_date'],
                'accounting_period_id' => $validated['accounting_period_id'],
                'branch_id' => $validated['branch_id'] ?? null,
                'source_type' => $validated['source_type'] ?? null,
                'source_id' => $validated['source_id'] ?? null,
                'source_event' => $validated['source_event'] ?? null,
                'status' => $validated['status'] ?? 'draft',
                'memo' => $validated['memo'],
                'created_by_account_id' => $request->user()?->id,
                'posted_at' => $validated['status'] === 'posted' ? now() : null,
            ]);

            $totalDebit = 0;
            $totalCredit = 0;

            foreach ($validated['lines'] as $lineData) {
                $debit = (int) ($lineData['debit_kobo'] ?? 0);
                $credit = (int) ($lineData['credit_kobo'] ?? 0);
                $totalDebit += $debit;
                $totalCredit += $credit;

                JournalLine::query()->create([
                    'journal_entry_id' => $entry->id,
                    'ledger_account_id' => $lineData['ledger_account_id'],
                    'branch_id' => $lineData['branch_id'] ?? null,
                    'customer_id' => $lineData['customer_id'] ?? null,
                    'supplier_id' => $lineData['supplier_id'] ?? null,
                    'debit_kobo' => $debit,
                    'credit_kobo' => $credit,
                    'description' => $lineData['description'] ?? null,
                ]);
            }

            if ($totalDebit !== $totalCredit) {
                throw new \RuntimeException('Total debits must equal total credits.');
            }

            $this->audit->record(
                $request,
                'journal_entry.created',
                'journal_entry',
                $entry,
                after: [
                    'journal_number' => $entry->journal_number,
                    'total_debit' => $totalDebit,
                    'total_credit' => $totalCredit,
                ],
            );

            return $entry;
        });

        return redirect()
            ->route('admin.accounting.journal-entries.show', $entry)
            ->with('status', 'Journal entry created successfully.');
    }

    public function show(JournalEntry $journalEntry): View
    {
        $journalEntry->load(['accountingPeriod', 'createdByAccount', 'lines.ledgerAccount', 'lines.branch', 'lines.customer', 'lines.supplier']);

        return view('admin.accounting.journal-entries.show', [
            'entry' => $journalEntry,
        ]);
    }

    public function edit(JournalEntry $journalEntry): View
    {
        if ($journalEntry->status !== 'draft') {
            return redirect()
                ->route('admin.accounting.journal-entries.show', $journalEntry)
                ->with('status', 'Only draft entries can be edited.');
        }

        $periods = AccountingPeriod::query()
            ->where('status', 'open')
            ->orderByDesc('starts_on')
            ->get(['id', 'name']);

        $accounts = LedgerAccount::query()
            ->where('is_active', true)
            ->where('allow_manual_posting', true)
            ->orderBy('code')
            ->get(['id', 'code', 'name', 'type']);

        return view('admin.accounting.journal-entries.edit', [
            'entry' => $journalEntry,
            'periods' => $periods,
            'accounts' => $accounts,
        ]);
    }

    public function update(UpdateJournalEntryRequest $request, JournalEntry $journalEntry): RedirectResponse
    {
        if ($journalEntry->status !== 'draft') {
            return redirect()
                ->route('admin.accounting.journal-entries.show', $journalEntry)
                ->with('status', 'Only draft entries can be updated.');
        }

        $validated = $request->validated();

        DB::transaction(function () use ($validated, $request, $journalEntry) {
            $before = [
                'entry_date' => $journalEntry->entry_date?->toDateString(),
                'memo' => $journalEntry->memo,
                'status' => $journalEntry->status,
            ];

            $journalEntry->update([
                'entry_date' => $validated['entry_date'],
                'accounting_period_id' => $validated['accounting_period_id'],
                'branch_id' => $validated['branch_id'] ?? null,
                'source_type' => $validated['source_type'] ?? null,
                'source_id' => $validated['source_id'] ?? null,
                'source_event' => $validated['source_event'] ?? null,
                'memo' => $validated['memo'],
                'status' => $validated['status'] ?? 'draft',
                'posted_at' => $validated['status'] === 'posted' ? now() : null,
            ]);

            // Delete existing lines and recreate
            $journalEntry->lines()->delete();
            $totalDebit = 0;
            $totalCredit = 0;

            foreach ($validated['lines'] as $lineData) {
                $debit = (int) ($lineData['debit_kobo'] ?? 0);
                $credit = (int) ($lineData['credit_kobo'] ?? 0);
                $totalDebit += $debit;
                $totalCredit += $credit;

                JournalLine::query()->create([
                    'journal_entry_id' => $journalEntry->id,
                    'ledger_account_id' => $lineData['ledger_account_id'],
                    'branch_id' => $lineData['branch_id'] ?? null,
                    'customer_id' => $lineData['customer_id'] ?? null,
                    'supplier_id' => $lineData['supplier_id'] ?? null,
                    'debit_kobo' => $debit,
                    'credit_kobo' => $credit,
                    'description' => $lineData['description'] ?? null,
                ]);
            }

            if ($totalDebit !== $totalCredit) {
                throw new \RuntimeException('Total debits must equal total credits.');
            }

            $this->audit->record(
                $request,
                'journal_entry.updated',
                'journal_entry',
                $journalEntry,
                before: $before,
                after: [
                    'entry_date' => $journalEntry->entry_date?->toDateString(),
                    'memo' => $journalEntry->memo,
                    'status' => $journalEntry->status,
                ],
            );
        });

        return redirect()
            ->route('admin.accounting.journal-entries.show', $journalEntry)
            ->with('status', 'Journal entry updated.');
    }

    private function generateJournalNumber(): string
    {
        $last = JournalEntry::query()
            ->where('journal_number', 'LIKE', 'JE-%')
            ->orderByDesc('journal_number')
            ->first();

        $number = $last ? (int) Str::after($last->journal_number, 'JE-') + 1 : 1;

        return 'JE-'.str_pad((string) $number, 6, '0', STR_PAD_LEFT);
    }
}
