<?php

declare(strict_types=1);

namespace App\Http\Controllers\Admin\Security;

use App\Models\AccountSession;
use App\Services\Organisation\AuditLogger;
use Carbon\CarbonInterface;
use Illuminate\Contracts\View\View;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Schema;

final readonly class LiveSessionController
{
    public function __construct(private AuditLogger $audit) {}

    public function index(): View
    {
        return view('admin.security.sessions', [
            'sessions' => AccountSession::query()
                ->with(
                    'account:id,first_name,last_name,profile_picture_path',
                )
                ->orderByDesc('last_activity_at')
                ->cursorPaginate(config('pagination.default', 10)),
        ]);
    }

    public function destroy(
        Request $request,
        AccountSession $session,
    ): RedirectResponse {
        /** @var array<string, CarbonInterface> $changes */
        $changes = [];

        if (
            Schema::hasColumn(
                $session->getTable(),
                'revoked_at',
            )
        ) {
            $changes['revoked_at'] = now();
        }

        if (
            Schema::hasColumn(
                $session->getTable(),
                'ended_at',
            )
        ) {
            $changes['ended_at'] = now();
        }

        if ($changes === []) {
            throw new \RuntimeException(
                'The session table has no supported termination column.',
            );
        }

        $session->forceFill($changes)->save();

        $this->audit->record(
            $request,
            'session.force-terminated',
            'account_session',
            $session,
            after: array_map(
                static fn (
                    CarbonInterface $value,
                ): string => $value->toIso8601String(),
                $changes,
            ),
        );

        return back()->with(
            'status',
            'Session terminated.',
        );
    }
}
