<?php

declare(strict_types=1);

namespace App\Http\Controllers\Admin\Commercial;

use App\Models\Customer;
use App\Queries\Commercial\CustomerReceivableQuery;
use Illuminate\Contracts\View\View;
use Illuminate\Http\Request;

final readonly class CustomerReceivableController
{
    public function __construct(
        private CustomerReceivableQuery $receivables,
    ) {}

    public function index(Request $request): View
    {
        return view('admin.commercial.receivables', [
            'customers' => $this->receivables->customers(
                $request->filled('search')
                    ? $request->string('search')->toString()
                    : null,
            ),
        ]);
    }

    public function show(Customer $customer): View
    {
        return view('admin.commercial.customer-receivable', [
            'customer' => $customer,
            'sales' => $customer->sales()
                ->whereNotIn('status', ['cancelled'])
                ->whereColumn('grand_total_kobo', '>', 'paid_amount_kobo')
                ->orderByDesc('sale_date')
                ->paginate(config('pagination.default', 10)),
        ]);
    }
}
