<?php

declare(strict_types=1);

namespace App\Http\Controllers\Admin\Customers;

use App\Http\Requests\Customers\StoreCustomerRequest;
use App\Models\Account;
use App\Models\Customer;
use App\Services\Catalog\MoneyInput;
use App\Services\Customers\CustomerCodeGenerator;
use App\Services\Organisation\AuditLogger;
use App\Support\Security\EncryptedValue;
use Illuminate\Contracts\View\View;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;

final readonly class CustomerController
{
    public function __construct(
        private CustomerCodeGenerator $codes,
        private MoneyInput $money,
        private EncryptedValue $encrypted,
        private AuditLogger $audit,
    ) {}

    public function index(Request $request): View
    {
        $search = $request->string('search')->trim()->toString();

        return view('admin.customers.index', [
            'customers' => Customer::query()
                ->when(
                    $search !== '',
                    static fn ($query) => $query->where(
                        static function ($nested) use ($search): void {
                            $nested
                                ->where('name', 'like', '%'.$search.'%')
                                ->orWhere('phone', 'like', '%'.$search.'%')
                                ->orWhere(
                                    'customer_code',
                                    'like',
                                    '%'.$search.'%',
                                );
                        },
                    ),
                )
                ->orderBy('name')
                ->cursorPaginate(config('pagination.default', 10))
                ->withQueryString(),
        ]);
    }

    public function store(
        StoreCustomerRequest $request,
    ): RedirectResponse|JsonResponse {
        /** @var Account $actor */
        $actor = $request->user();

        $customer = Customer::query()->create([
            'customer_code' => $this->codes->generate(),
            'name' => $request->string('name')->trim()->toString(),
            'phone' => $request->string('phone')->trim()->toString(),
            'email_encrypted' => $request->filled('email')
                ? $this->encrypted->encrypt(
                    $request->string('email')->trim()->toString(),
                )
                : null,
            'address' => $request->filled('address')
                ? $request->string('address')->trim()->toString()
                : null,
            'credit_limit_kobo' => $this->money->toKobo(
                $request->input('credit_limit'),
            ) ?? 0,
            'balance_kobo' => 0,
            'is_wholesale' => $request->boolean('is_wholesale'),
            'status' => 'active',
            'created_by_account_id' => $actor->getKey(),
        ]);

        $this->audit->record(
            $request,
            'customer.created',
            'customer',
            $customer,
            after: [
                'customer_code' => $customer->customer_code,
                'name' => $customer->name,
                'phone' => $customer->phone,
                'is_wholesale' => $customer->is_wholesale,
            ],
        );

        if ($request->expectsJson()) {
            return response()->json([
                'id' => (string) $customer->getKey(),
                'customer_code' => $customer->customer_code,
                'name' => $customer->name,
                'phone' => $customer->phone,
            ], 201);
        }

        return back()->with('status', 'Customer created.');
    }

    public function search(Request $request): JsonResponse
    {
        $search = $request->string('search')->trim()->toString();

        if (mb_strlen($search) < 2) {
            return response()->json(['data' => []]);
        }

        return response()->json([
            'data' => Customer::query()
                ->where('status', 'active')
                ->where(static function ($query) use ($search): void {
                    $query
                        ->where('name', 'like', '%'.$search.'%')
                        ->orWhere('phone', 'like', '%'.$search.'%')
                        ->orWhere(
                            'customer_code',
                            'like',
                            '%'.$search.'%',
                        );
                })
                ->orderBy('name')
                ->limit(20)
                ->get(['id', 'customer_code', 'name', 'phone']),
        ]);
    }
}
