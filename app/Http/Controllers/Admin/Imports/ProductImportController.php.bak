<?php

declare(strict_types=1);

namespace App\Http\Controllers\Admin\Imports;

use App\Actions\Imports\ProcessProductImport;
use App\Actions\Imports\ValidateProductImport;
use App\Enums\Imports\ImportStatus;
use App\Exports\ProductImportTemplateExport;
use App\Http\Requests\Admin\Imports\UploadProductImportRequest;
use App\Models\Account;
use App\Models\ProductImport;
use App\Services\Organisation\AuditLogger;
use Illuminate\Contracts\View\View;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Storage;
use Symfony\Component\HttpFoundation\BinaryFileResponse;

final readonly class ProductImportController
{
    public function __construct(private AuditLogger $audit) {}

    public function index(): View
    {
        return view('admin.imports.products.index', [
            'imports' => ProductImport::query()
                ->with('account:id,first_name,last_name')
                ->orderByDesc('created_at')
                ->cursorPaginate(config('pagination.default', 10)),
        ]);
    }

    public function template(
        ProductImportTemplateExport $export,
    ): BinaryFileResponse {
        return $export->download();
    }

    public function store(
        UploadProductImportRequest $request,
        ValidateProductImport $validator,
    ): RedirectResponse {
        /** @var Account $account */
        $account = $request->user();

        $import = $validator->execute(
            $request->file('workbook'),
            $account,
        );

        $this->audit->record(
            $request,
            'product-import.validated',
            'product_import',
            $import,
            after: [
                'status' => $import->status instanceof ImportStatus
                    ? $import->status->value
                    : (string) $import->status,
                'total_rows' => $import->total_rows,
                'valid_rows' => $import->valid_rows,
                'invalid_rows' => $import->invalid_rows,
            ],
        );

        return redirect()->route(
            'admin.imports.products.show',
            $import,
        );
    }

    public function show(ProductImport $import): View
    {
        return view('admin.imports.products.show', [
            'import' => $import,
            'previewRows' => $import->rows()
                ->orderBy('row_number')
                ->limit((int) config(
                    'imports.products.preview_rows',
                    50,
                ))
                ->get(),
        ]);
    }

    public function process(
        Request $request,
        ProductImport $import,
        ProcessProductImport $processor,
    ): RedirectResponse {
        $counts = $processor->execute($import);

        $this->audit->record(
            $request,
            'product-import.completed',
            'product_import',
            $import,
            after: $counts,
        );

        return back()->with(
            'status',
            'Product import completed successfully.',
        );
    }

    public function errors(
        ProductImport $import,
    ): BinaryFileResponse {
        abort_unless(
            is_string($import->error_report_path)
            && $import->error_report_path !== '',
            404,
        );

        $disk = (string) config('imports.products.disk', 'local');

        abort_unless(
            Storage::disk($disk)->exists(
                $import->error_report_path,
            ),
            404,
        );

        return response()->download(
            Storage::disk($disk)->path(
                $import->error_report_path,
            ),
            'product-import-errors-'.$import->getKey().'.xlsx',
        );
    }
}
